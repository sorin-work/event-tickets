# Copy to .env next to docker-compose.yml; Compose reads it automatically.

# Port on your machine for the web app and the database.
WEB_PORT=4411
DB_PORT=5432

# First admin account (only used while there are no admins).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=demo-password

# Public address used in email links.
BASE_URL=http://localhost:4411

# Sample events and orders on first start.
SEED_DEMO=true
